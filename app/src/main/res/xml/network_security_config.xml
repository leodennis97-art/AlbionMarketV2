<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- System & User Certificates Policy -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Specific Domain Security Rules with Certificate Pinning for Production Endpoints -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">albiononlinebuilds.com</domain>
        <domain includeSubdomains="true">ngrok-free.dev</domain>
        <domain includeSubdomains="true">loca.lt</domain>
        <domain includeSubdomains="true">albion-online.com</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.179.7</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
