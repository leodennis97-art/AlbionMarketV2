<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Standardkonfiguration für HTTPS-Verbindungen -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- HTTPS & Outbound Domain Endpoints -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">AlbionDataPro.com</domain>
        <domain includeSubdomains="true">onrender.com</domain>
        <domain includeSubdomains="true">216.24.57.1</domain>
        <domain includeSubdomains="true">albiononlinebuilds.com</domain>
        <domain includeSubdomains="true">albion-online.com</domain>
        <domain includeSubdomains="true">74.220.51.1</domain>
        <domain includeSubdomains="true">74.220.59.1</domain>
        <domain includeSubdomains="true">74.220.51.0</domain>
        <domain includeSubdomains="true">74.220.59.0</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>